#include <windows.h>
#include <commctrl.h>

1 ICON "icon.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "deadeye.manifest"

100 DIALOGEX 0, 0, 438, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTEXTHELP
CAPTION "Deadeye customization"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	CONTROL "", 101, "Static", SS_OWNERDRAW, 7, 7, 130, 104
	RTEXT "", 109, 7, 113, 130, 8
	AUTOCHECKBOX "Use Windows display scaling", 102, 7, 128, 130, 10

	LTEXT "Profile", -1, 7, 146, 130, 8
	COMBOBOX 103, 7, 156, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	PUSHBUTTON "New...", 104, 7, 173, 41, 14
	PUSHBUTTON "Rename...", 105, 52, 173, 41, 14
	PUSHBUTTON "Delete", 106, 96, 173, 41, 14

	GROUPBOX "Bars", -1, 144, 2, 140, 200
	AUTOCHECKBOX "Show bars", 110, 152, 15, 60, 10
	AUTOCHECKBOX "Top", 111, 152, 29, 28, 10
	AUTOCHECKBOX "Bottom", 112, 182, 29, 36, 10
	AUTOCHECKBOX "Left", 113, 220, 29, 28, 10
	AUTOCHECKBOX "Right", 114, 250, 29, 30, 10
	LTEXT "Color", -1, 152, 46, 50, 8
	EDITTEXT 115, 205, 44, 52, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", 116, 259, 44, 18, 12
	LTEXT "Length", -1, 152, 61, 50, 8
	EDITTEXT 117, 205, 59, 40, 12, ES_NUMBER
	CONTROL "", 118, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 248, 61, 12, 8
	LTEXT "Thickness", -1, 152, 76, 50, 8
	EDITTEXT 119, 205, 74, 40, 12, ES_NUMBER
	CONTROL "", 120, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 248, 76, 12, 8
	LTEXT "Gap", -1, 152, 91, 50, 8
	EDITTEXT 121, 205, 89, 40, 12, ES_NUMBER
	CONTROL "", 122, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 248, 91, 12, 8
	LTEXT "Shape", -1, 152, 106, 50, 8
	COMBOBOX 123, 205, 104, 72, 60, CBS_DROPDOWNLIST | WS_TABSTOP
	LTEXT "Opacity", -1, 152, 121, 50, 8
	CONTROL "", 124, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 200, 119, 58, 13
	LTEXT "", 125, 259, 121, 20, 8
	AUTOCHECKBOX "Outline", 126, 152, 138, 60, 10
	LTEXT "Color", -1, 162, 154, 40, 8
	EDITTEXT 127, 205, 152, 52, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", 128, 259, 152, 18, 12
	LTEXT "Thickness", -1, 162, 169, 40, 8
	EDITTEXT 129, 205, 167, 40, 12, ES_NUMBER
	CONTROL "", 130, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 248, 169, 12, 8
	LTEXT "Opacity", -1, 162, 184, 40, 8
	CONTROL "", 131, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 200, 182, 58, 13
	LTEXT "", 132, 259, 184, 20, 8

	GROUPBOX "Center dot", -1, 291, 2, 140, 155
	AUTOCHECKBOX "Show dot", 140, 299, 15, 60, 10
	LTEXT "Color", -1, 299, 31, 50, 8
	EDITTEXT 141, 352, 29, 52, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", 142, 406, 29, 18, 12
	LTEXT "Size", -1, 299, 46, 50, 8
	EDITTEXT 143, 352, 44, 40, 12, ES_NUMBER
	CONTROL "", 144, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 395, 46, 12, 8
	LTEXT "Shape", -1, 299, 61, 50, 8
	COMBOBOX 145, 352, 59, 72, 60, CBS_DROPDOWNLIST | WS_TABSTOP
	LTEXT "Opacity", -1, 299, 76, 50, 8
	CONTROL "", 146, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 347, 74, 58, 13
	LTEXT "", 147, 406, 76, 20, 8
	AUTOCHECKBOX "Outline", 148, 299, 93, 60, 10
	LTEXT "Color", -1, 309, 109, 40, 8
	EDITTEXT 149, 352, 107, 52, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", 150, 406, 107, 18, 12
	LTEXT "Thickness", -1, 309, 124, 40, 8
	EDITTEXT 151, 352, 122, 40, 12, ES_NUMBER
	CONTROL "", 152, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
	LTEXT "px", -1, 395, 124, 12, 8
	LTEXT "Opacity", -1, 309, 139, 40, 8
	CONTROL "", 153, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 347, 137, 58, 13
	LTEXT "", 154, 406, 139, 20, 8

	PUSHBUTTON "Save", 107, 327, 188, 50, 14
	PUSHBUTTON "Revert", 108, 381, 188, 50, 14
END

200 DIALOGEX 0, 0, 186, 50
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Profile name"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	LTEXT "Name", -1, 7, 9, 30, 8
	EDITTEXT 201, 40, 7, 139, 12, ES_AUTOHSCROLL
	DEFPUSHBUTTON "OK", IDOK, 75, 29, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 129, 29, 50, 14
END
